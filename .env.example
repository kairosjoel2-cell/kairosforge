# Database (PostgreSQL). Get a free connection string at https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/kairosforge"

# Auth secret for JWT signing. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# AI provider (openai | anthropic). Get an API key at https://platform.openai.com or https://console.anthropic.com
AI_PROVIDER="openai"
AI_API_KEY="sk-..."
AI_MODEL="gpt-4o"

# Optional: GitHub OAuth App for "Export to GitHub" (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional: encryption key for storing user GitHub tokens (openssl rand -hex 32)
GITHUB_TOKEN_ENCRYPTION_KEY=""
